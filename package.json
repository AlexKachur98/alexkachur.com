{
  "name": "alexkachur.com",
  "description": "A portfolio that compiles to a SQLite database, answers questions by writing SQL, exposes a public API, and caps its own AI spending.",
  "author": "Alex Kachur",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/build-db.ts && node scripts/build-images.ts && astro dev",
    "build": "node scripts/build-db.ts && node scripts/build-images.ts && astro build",
    "preview": "astro preview",
    "check": "node scripts/build-db.ts && astro check",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "node scripts/eval.ts",
    "eval:record": "node --env-file-if-exists=.env scripts/eval.ts --record",
    "eval:live": "node --env-file-if-exists=.env scripts/eval.ts --live",
    "questions": "node --env-file-if-exists=.env scripts/questions.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@astrojs/markdown-satteri": "0.4.1",
    "@astrojs/vercel": "^11.0.10",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.8",
    "astro": "^7.3.3",
    "sql.js": "1.14.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@jsonresume/schema": "~1.3.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/sql.js": "^1.4.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "harfbuzzjs": "1.6.2",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "unpdf": "1.8.1",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
