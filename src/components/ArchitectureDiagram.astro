---
// The architecture diagram: monochrome, with the request path of /api/ask marked in --mark,
// yellow in the dark theme and ink in the light one, where yellow would not show. The labels are
// the words of the description a reader who cannot see the drawing gets; the name is the page's
// section title, or the sentence a home page row gives it. The drawing keeps its natural width so
// the text stays on the type scale; below 768px a stacked drawing of the same boxes and words
// takes its place, 272px wide, so it fits a 320px screen whole. Each drawing has its own markers:
// Chrome draws no arrowhead from a marker inside a hidden drawing. The figure is the page's own,
// not part of the text the sections table holds.
interface Props {
  title?: string;
}

const { title = 'Architecture' } = Astro.props;
const description =
  "At build time, the site's Markdown and YAML become a SQLite database and JSON endpoints. Your browser loads the database with sql.js when you need it. Your question goes to /api/ask, which sends it with the schema to a language model, checks the SQL that comes back by preparing it against the real database, and returns the SQL to your browser to run. The model never runs a query and never sees the results.";
---

<figure class="diagram-figure" data-page-only>
  <svg class="diagram diagram-wide" width="456" height="324" viewBox="0 0 456 324" role="img" aria-labelledby="architecture-title" aria-describedby="architecture-desc">
    <title id="architecture-title">{title}</title>
    <desc id="architecture-desc">{description}</desc>
    <defs>
      <marker id="arch-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path class="head" d="M0 0 L8 4 L0 8 Z"></path>
      </marker>
      <marker id="arch-arrow-ask" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
        <path class="head-ask" d="M0 0 L8 4 L0 8 Z"></path>
      </marker>
    </defs>

    <rect class="box" x="16" y="8" width="200" height="32"></rect>
    <text class="label center" x="116" y="24">Markdown and YAML</text>

    <line class="arrow" x1="116" y1="40" x2="116" y2="72"></line>
    <text class="note" x="124" y="56">at build time</text>
    <path class="arrow" d="M216 24 H340 V72"></path>

    <rect class="box" x="16" y="72" width="200" height="32"></rect>
    <text class="label center" x="116" y="88">SQLite database</text>
    <rect class="box" x="240" y="72" width="200" height="32"></rect>
    <text class="label center" x="340" y="88">JSON endpoints</text>

    <line class="arrow" x1="116" y1="104" x2="116" y2="144"></line>
    <text class="note" x="124" y="124">when you need it</text>

    <rect class="box" x="16" y="144" width="200" height="48"></rect>
    <text class="label center" x="116" y="160">your browser</text>
    <text class="label center" x="116" y="178">sql.js</text>

    <text class="note" x="228" y="132">your question</text>
    <g class="ask-path">
      <line x1="216" y1="154" x2="240" y2="154"></line>
      <line x1="364" y1="208" x2="364" y2="240"></line>
      <line x1="316" y1="240" x2="316" y2="208"></line>
      <line x1="240" y1="182" x2="216" y2="182"></line>
    </g>

    <rect class="box" x="240" y="144" width="200" height="64"></rect>
    <text class="label center" x="340" y="158">/api/ask</text>
    <text class="note center" x="340" y="176">preparing it against</text>
    <text class="note center" x="340" y="193">the real database</text>

    <text class="note" x="372" y="224">the schema</text>
    <text class="note right" x="308" y="224">SQL</text>

    <rect class="box" x="240" y="240" width="200" height="32"></rect>
    <text class="label center" x="340" y="256">language model</text>
    <text class="note center" x="228" y="296">The model never runs a query</text>
    <text class="note center" x="228" y="313">and never sees the results.</text>
  </svg>
  <svg class="diagram diagram-phone" width="272" height="418" viewBox="0 0 272 418" role="img" aria-labelledby="architecture-title-phone" aria-describedby="architecture-desc-phone">
    <title id="architecture-title-phone">{title}</title>
    <desc id="architecture-desc-phone">{description}</desc>
    <defs>
      <marker id="arch-arrow-phone" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path class="head" d="M0 0 L8 4 L0 8 Z"></path>
      </marker>
      <marker id="arch-arrow-ask-phone" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
        <path class="head-ask" d="M0 0 L8 4 L0 8 Z"></path>
      </marker>
    </defs>

    <rect class="box" x="8" y="8" width="256" height="32"></rect>
    <text class="label center" x="136" y="24">Markdown and YAML</text>

    <line class="arrow" x1="70" y1="40" x2="70" y2="72"></line>
    <line class="arrow" x1="202" y1="40" x2="202" y2="72"></line>
    <text class="note center" x="136" y="56">at build time</text>

    <rect class="box" x="8" y="72" width="124" height="48"></rect>
    <text class="label center" x="70" y="88">SQLite</text>
    <text class="label center" x="70" y="106">database</text>
    <rect class="box" x="140" y="72" width="124" height="48"></rect>
    <text class="label center" x="202" y="88">JSON</text>
    <text class="label center" x="202" y="106">endpoints</text>

    <line class="arrow" x1="70" y1="120" x2="70" y2="152"></line>
    <text class="note" x="78" y="136">when you need it</text>

    <rect class="box" x="8" y="152" width="256" height="48"></rect>
    <text class="label center" x="136" y="168">your browser</text>
    <text class="label center" x="136" y="186">sql.js</text>

    <g class="ask-path">
      <line x1="48" y1="200" x2="48" y2="232"></line>
      <line x1="224" y1="232" x2="224" y2="200"></line>
      <line x1="48" y1="296" x2="48" y2="328"></line>
      <line x1="224" y1="328" x2="224" y2="296"></line>
    </g>
    <text class="note" x="56" y="216">your question</text>

    <rect class="box" x="8" y="232" width="256" height="64"></rect>
    <text class="label center" x="136" y="246">/api/ask</text>
    <text class="note center" x="136" y="264">preparing it against</text>
    <text class="note center" x="136" y="281">the real database</text>

    <text class="note" x="56" y="312">the schema</text>
    <text class="note right" x="216" y="312">SQL</text>

    <rect class="box" x="8" y="328" width="256" height="32"></rect>
    <text class="label center" x="136" y="344">language model</text>
    <text class="note center" x="136" y="384">The model never runs a query</text>
    <text class="note center" x="136" y="402">and never sees the results.</text>
  </svg>
</figure>

<style>
  .diagram-figure {
    margin-block: var(--space-4) var(--space-6);
    overflow-x: auto;
  }

  .diagram {
    display: block;
    font-family: var(--font-mono);
  }

  .diagram-wide {
    display: none;
  }

  .box {
    fill: var(--surface);
    stroke: var(--muted);
    stroke-width: 1;
  }

  .arrow {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    marker-end: url("#arch-arrow");
  }

  .diagram-phone .arrow {
    marker-end: url("#arch-arrow-phone");
  }

  .head {
    fill: var(--ink);
  }

  /* The one highlight in the drawing: the request path of /api/ask, a 2px rule in --mark with a
     larger arrowhead, so the path reads by weight as well as by colour. */
  .ask-path line {
    stroke: var(--mark);
    stroke-width: 2;
    marker-end: url("#arch-arrow-ask");
  }

  .diagram-phone .ask-path line {
    marker-end: url("#arch-arrow-ask-phone");
  }

  .head-ask {
    fill: var(--mark);
  }

  .label,
  .note {
    font-size: var(--text-xs);
    dominant-baseline: middle;
  }

  .label {
    fill: var(--ink);
  }

  .note {
    fill: var(--muted);
  }

  .center {
    text-anchor: middle;
  }

  .right {
    text-anchor: end;
  }

  @media (min-width: 768px) {
    .diagram-phone {
      display: none;
    }

    .diagram-wide {
      display: block;
    }
  }
</style>
