---
// The architecture diagram: monochrome, with the request path of /api/ask marked in
// yellow. The labels are the words of the /how-this-site-works intro. The drawing keeps its
// natural width so the text stays on the type scale; a phone scrolls it sideways.
---

<figure class="diagram-figure">
  <!-- TODO: settle the wording of the labels and write a sentence describing the diagram for readers who cannot see it. -->
  <svg class="diagram" width="456" height="312" viewBox="0 0 456 312" role="img" aria-labelledby="architecture-title">
    <title id="architecture-title">Architecture</title>
    <defs>
      <marker id="arch-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path class="head" d="M0 0 L8 4 L0 8 Z"></path>
      </marker>
      <marker id="arch-arrow-ask" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto">
        <path class="head-ask" d="M0 0 L8 4 L0 8 Z"></path>
      </marker>
    </defs>

    <rect class="box" x="16" y="8" width="200" height="32"></rect>
    <text class="label center" x="116" y="24">Markdown and YAML</text>

    <line class="arrow" x1="116" y1="40" x2="116" y2="72"></line>
    <text class="note" x="124" y="56">at build time</text>
    <path class="arrow" d="M216 24 H340 V72"></path>

    <rect class="box" x="16" y="72" width="200" height="32"></rect>
    <text class="label center" x="116" y="88">SQLite database</text>
    <rect class="box" x="240" y="72" width="200" height="32"></rect>
    <text class="label center" x="340" y="88">JSON endpoints</text>

    <line class="arrow" x1="116" y1="104" x2="116" y2="144"></line>
    <text class="note" x="124" y="124">on demand</text>

    <rect class="box" x="16" y="144" width="200" height="48"></rect>
    <text class="label center" x="116" y="160">your browser</text>
    <text class="label center" x="116" y="178">sql.js</text>

    <text class="note" x="228" y="132">your question</text>
    <g class="ask-path">
      <line x1="216" y1="154" x2="240" y2="154"></line>
      <line x1="364" y1="208" x2="364" y2="240"></line>
      <line x1="316" y1="240" x2="316" y2="208"></line>
      <line x1="240" y1="182" x2="216" y2="182"></line>
    </g>

    <rect class="box" x="240" y="144" width="200" height="64"></rect>
    <text class="label center" x="340" y="158">/api/ask</text>
    <text class="note center" x="340" y="176">preparing it against</text>
    <text class="note center" x="340" y="193">the real database</text>

    <text class="note" x="372" y="224">the schema</text>
    <text class="note right" x="308" y="224">SQL</text>

    <rect class="box" x="240" y="240" width="200" height="32"></rect>
    <text class="label center" x="340" y="256">language model</text>
    <text class="note center" x="228" y="296">The model never touches the data.</text>
  </svg>
</figure>

<style>
  .diagram-figure {
    margin-block: var(--space-4) var(--space-6);
    overflow-x: auto;
  }

  .diagram {
    display: block;
    font-family: var(--font-mono);
  }

  .box {
    fill: var(--surface);
    stroke: var(--muted);
    stroke-width: 1;
  }

  .arrow {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    marker-end: url("#arch-arrow");
  }

  .head {
    fill: var(--ink);
  }

  /* The one highlight on this page: the request path of /api/ask, a 2px accent rule. */
  .ask-path line {
    stroke: var(--accent);
    stroke-width: 2;
    marker-end: url("#arch-arrow-ask");
  }

  .head-ask {
    fill: var(--accent);
  }

  .label,
  .note {
    font-size: var(--text-xs);
    dominant-baseline: middle;
  }

  .label {
    fill: var(--ink);
  }

  .note {
    fill: var(--muted);
  }

  .center {
    text-anchor: middle;
  }

  .right {
    text-anchor: end;
  }
</style>
