---
import { answerExample, chips, examples } from '../data/examples.ts';
import { QUESTION_LENGTH } from '../lib/ask/question.ts';
import { keptFor, TTL } from '../lib/ask/storage.ts';
import { dataFile } from '../lib/data-file.ts';
import { select } from '../lib/query.ts';
import { ROWS } from '../lib/result-rows.ts';
import { THUMB, renderCell, sqlTokens, summary, visibleRows } from '../scripts/results.ts';
import type { Result } from '../scripts/results.ts';
import '../styles/console.css';

// The Ask box: a question goes to /api/ask and the SQL that comes back runs in the browser; a chip
// runs reviewed SQL with no request. The answer area is always in the markup, so its live regions
// exist before anything is written to them. The box is marked data-nosnippet: its controls and
// data are not the page's text for a search result to quote.
interface Props {
  // Adds Edit this query; the 404 page has no console to edit in.
  editable?: boolean;
  // From 1200px, sets the answer beside the form, showing an answer run at build time until the
  // first question.
  example?: boolean;
}

const { editable = false, example = false } = Astro.props;
const database = dataFile('portfolio.sqlite');
const kb = Math.round(database.bytes / 1000);

// As the browser's worker runs a query: stepped to one row past the cap.
async function run(sql: string): Promise<Result> {
  const { columns, rows } = await select(sql, ROWS + 1);
  return { columns, rows, truncated: rows.length === ROWS + 1 };
}

const shown = example ? answerExample : undefined;
const answer = shown ? await run(shown.sql) : undefined;
---

<div class:list={['console cut ask', { 'ask-split': example }]} data-ask data-nosnippet data-kb={kb} data-db-url={database.url}>
  <!-- Outside a dialog, method="dialog" makes the browser's own submission a no-op, so a question
       typed before the script loads, or with scripts off, never lands in the URL; the submit
       event still fires. -->
  <form class="ask-form" method="dialog" data-ask-form>
    <label class="ask-label" for="ask-input">Ask about Alex in plain English. The site writes SQL, and you can read it.</label>
    <div class="ask-row">
      <!-- Escape in the field does what the clear control does, so the control is not a Tab stop
           and Tab goes on to Ask. -->
      <div class="ask-field">
        <input class="input" id="ask-input" type="text" maxlength={QUESTION_LENGTH.max} autocomplete="off" data-ask-input />
        <button type="button" class="ask-clear" tabindex="-1" data-ask-clear hidden>
          <span class="visually-hidden">Clear question</span>
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <button type="submit" class="button button-primary cut">Ask</button>
    </div>
    <ul class="ask-chips" role="list">
      {
        chips.map((chip) => (
          <li>
            <button type="button" class="button chip" data-sql={chip.sql} data-more={chip.more ? examples.indexOf(chip) : undefined}>
              {chip.label}
            </button>
          </li>
        ))
      }
    </ul>
    <p class="ask-privacy">Your question goes to an AI service to become SQL. This site never logs it.</p>
  </form>
  <div class="console ask-panel" data-ask-panel>
    {
      shown && answer && (
        <div class="ask-example-answer" data-ask-example>
          <p class="console-head" id="ask-example-answer-head">
            <span class="ask-head-question">
              <span>Example</span>{' '}
              <span class="console-dot" aria-hidden="true">·</span>{' '}
              <span>{shown.label}</span>
            </span>{' '}
            <span class="ask-head-status">{summary(answer)}</span>
          </p>
          <pre class="ask-sql">{sqlTokens(shown.sql).map(({ text, keyword }) => (keyword ? <span class="sql-keyword">{text}</span> : text))}</pre>
          {editable && (
            <button type="button" class="console-run" data-ask-edit data-sql={shown.sql}>
              Edit this query
            </button>
          )}
          <div class="console-results" role="region" aria-labelledby="ask-example-answer-head" tabindex="0">
            <table>
              <thead>
                <tr>
                  {answer.columns.map((column) => (
                    <th scope="col">{column}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {visibleRows(answer).map((row) => (
                  <tr>
                    {row.map((value, index) => {
                      const cell = renderCell(answer.columns[index] ?? '', value);
                      if (cell.kind === 'image') {
                        return (
                          <td>
                            <a href={cell.src}>
                              <img src={cell.src} alt={cell.alt} width={THUMB} height={THUMB} loading="lazy" />
                            </a>
                          </td>
                        );
                      }
                      if (cell.kind === 'link') {
                        return (
                          <td>
                            <a href={cell.href}>{cell.text}</a>
                          </td>
                        );
                      }
                      return <td class={cell.empty ? 'null' : undefined}>{cell.text}</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
    <p class="console-head" data-ask-head>
      <span class="ask-head-question" id="ask-question" data-ask-question></span>{' '}
      <span class="ask-head-status">
        <span id="ask-status" role="status" data-ask-status></span>{' '}
        <span data-ask-scroll-cue hidden><span class="console-dot" aria-hidden="true">·</span> scrollable</span>{' '}
        <span class="console-cursor" aria-hidden="true"></span>
      </span>
    </p>
    <!-- A refusal is answered by this line alone, with nothing on the status line, so it
         announces itself. -->
    <p class="ask-explanation" aria-live="polite" data-ask-explanation></p>
    <pre class="ask-sql" data-ask-sql></pre>
    {editable && <button type="button" class="console-run" data-ask-edit hidden>Edit this query</button>}
    <p class="console-error" role="alert" data-ask-error></p>
    <div class="console-results" role="region" aria-labelledby="ask-question ask-status" data-ask-results hidden></div>
    {
      examples.map(
        (example, index) =>
          example.more && (
            <p class="ask-more" data-ask-more={index} hidden>
              <a href={example.more.href}>{example.more.link}</a>{example.more.rest}
            </p>
          ),
      )
    }
    <div class="ask-send" data-ask-send-block hidden>
      <button type="button" class="console-run" data-ask-send aria-describedby="ask-send-note">Send this question to Alex</button>
      <p class="ask-send-note" id="ask-send-note">Only if you choose: the question is kept for {keptFor(TTL.sentQuestion)} so I can add what's missing. Nothing else is sent.</p>
    </div>
    <!-- Focused when a send goes through, so the confirmation is read out where the button was. -->
    <p class="ask-sent" tabindex="-1" data-ask-sent hidden>Sent. Thanks.</p>
    <ul class="ask-fallback" role="list" data-ask-fallback hidden>
      {
        examples.map((example, index) => (
          <li>
            <button type="button" class="ask-example text-button" data-sql={example.sql} data-more={example.more ? index : undefined}>
              {example.label}
            </button>
            <code>{example.sql}</code>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .ask {
    padding: var(--space-5);
  }

  /* The panel sets monospace for the answer; the question form keeps the page's type. */
  .ask-form {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    line-height: var(--leading-body);
  }

  .ask-label {
    display: block;
    margin-bottom: var(--space-3);
    font-weight: 600;
  }

  .ask-row {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  /* The clear control's 44px target stands 2px proud of the 40px field above and below. The field
     keeps that width free of text whether or not the control shows, so text never moves. */
  .ask-field {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .ask-field .input {
    display: block;
    width: 100%;
    padding-right: calc(var(--control) + var(--space-1));
  }

  .ask-clear {
    position: absolute;
    top: calc(var(--space-1) / -2);
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--control) + var(--space-1));
    height: calc(var(--control) + var(--space-1));
    padding: 0;
    border: 0;
    background: none;
    color: var(--console-muted);
    font-size: var(--text-lg);
    transition: color var(--duration) var(--ease);
  }

  @media (hover: hover) {
    .ask-clear:hover {
      color: var(--console-accent);
    }
  }

  /* One chip per line at every width, so the questions read as a list. */
  .ask-chips {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
  }

  .ask-chips li {
    margin: 0;
    max-width: none;
  }

  .ask-privacy {
    margin: 0;
    color: var(--console-muted);
    font-size: var(--text-sm);
  }

  /* Inside the box's padding, so it has none of its own; it keeps the console class for the working
     cursor. Closed, it takes no space. */
  .ask-panel {
    margin-top: var(--space-4);
    padding: 0;
  }

  .ask-panel:not([data-open]) {
    margin: 0;
  }

  .ask-panel:not([data-open]) > .console-head {
    margin: 0;
  }

  /* The room the page leaves above or below the answer when it scrolls the answer into sight. Under
     the form it is the panel's own gap below the privacy note, so the note is never cut through. */
  .ask-panel,
  .ask-panel > .console-head {
    scroll-margin: var(--space-4);
  }

  /* The question, balanced like a heading, over a status line that keeps its height while the panel
     is open, so nothing below moves as "working" gives way to the row count. */
  .ask-panel .console-head {
    display: block;
  }

  .ask-head-question {
    display: block;
    text-wrap: balance;
  }

  .ask-head-status {
    display: block;
  }

  .ask-panel[data-open] .ask-head-status {
    min-height: calc(var(--leading-mono) * 1em);
  }

  .ask-panel .console-cursor {
    vertical-align: baseline;
  }

  /* The example shows only beside the form, from 1200px. Its rows are part of the page, so they skip
     the row reveal. */
  .ask-example-answer {
    display: none;
  }

  .ask-example-answer tbody tr {
    animation: none;
  }

  .ask-explanation,
  .ask-sql,
  .ask-more {
    margin: 0;
    max-width: none;
  }

  .ask-more {
    margin-top: var(--space-3);
  }

  .ask-send,
  .ask-sent {
    margin-top: var(--space-4);
  }

  /* The consent sentence reads like the privacy note under the form. */
  .ask-send-note {
    margin: var(--space-2) 0 0;
    color: var(--console-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .ask-sent {
    margin-bottom: 0;
  }

  .ask-explanation:not(:empty) {
    margin-bottom: var(--space-3);
  }

  /* The question is the visitor's and the explanation the model's, so a word longer than the line,
     such as a pasted address, breaks where it must instead of widening the page. */
  .ask-head-question,
  .ask-explanation {
    overflow-wrap: anywhere;
  }

  /* Wrapped rather than scrolled, and without the page's code-block frame. */
  .ask-sql {
    padding: 0;
    border: 0;
    background: none;
    color: var(--console-ink);
    font-size: inherit;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .ask-sql:not(:empty) {
    margin-bottom: var(--space-3);
  }

  .ask-fallback {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .ask-fallback li {
    margin: 0;
    max-width: none;
  }

  .ask-fallback li + li {
    margin-top: var(--space-2);
  }

  /* A label that wraps lines up on the left, as text does. */
  .ask-example {
    text-align: left;
  }

  .ask-fallback code {
    display: block;
    color: var(--console-muted);
    overflow-wrap: anywhere;
  }

  @media (min-width: 1200px) {
    .ask {
      padding: var(--space-6);
    }

    /* A subgrid of the page's twelve columns, so the split falls on the page's column line 8; the
       box's padding only insets the outer tracks. Without subgrid the box stays whole, answers open
       under the form, and there is no example. */
    @supports (grid-template-columns: subgrid) {
      .ask-split {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
      }

      /* The privacy note sits at the foot of the form's column, level with the end of the taller
         answer pane. */
      .ask-split .ask-form {
        display: flex;
        flex-direction: column;
        grid-column: 1 / 8;
      }

      .ask-split .ask-privacy {
        margin-top: auto;
      }

      /* The pane keeps the example's height as its smallest (begin() in console.ts records it), so
         a short answer moves nothing below it. */
      .ask-split .ask-panel {
        position: relative;
        grid-column: 8 / 13;
        min-height: var(--example-height, auto);
        margin: 0;
      }

      .ask-split .ask-panel::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: calc(var(--space-5) / -2);
        width: 1px;
        background: var(--console-rule);
      }

      .ask-split .ask-example-answer {
        display: block;
      }

      /* A long answer here would stretch the hero, so its rows scroll in a box with the column
         names held at the top. Only with a mouse or trackpad, since on a touch screen the box would
         take the page's swipes, and only on a window tall enough that the box fills at most 59% of
         it. The scroll padding keeps a focused link clear of the held header row; with separate
         borders each header cell keeps its rule. */
      @media (min-height: 42.5rem) and (hover: hover) and (pointer: fine) {
        .ask-split .console-results {
          max-height: 25rem;
          overflow: auto;
          scroll-padding-top: calc(var(--text-xs) * var(--leading-mono) + var(--space-2) * 3 + 1px);
          scroll-padding-bottom: var(--space-2);
        }

        .ask-split .console-results :global(table) {
          border-collapse: separate;
          border-spacing: 0;
        }

        .ask-split .console-results :global(th) {
          position: sticky;
          top: 0;
          background: var(--console-bg);
          white-space: nowrap;
        }
      }
    }
  }
</style>
