---
import { answerExample, chips, examples } from '../data/examples.ts';
import { openDatabase } from '../lib/ask/db.ts';
import { QUESTION_LENGTH } from '../lib/ask/handler.ts';
import { keptFor, TTL } from '../lib/ask/storage.ts';
import { dataFile } from '../lib/data-file.ts';
import { ROWS, THUMB, renderCell, sqlTokens, summary, visibleRows } from '../scripts/console.ts';
import type { Cell, Result } from '../scripts/console.ts';
import '../styles/console.css';

// The Ask box: a question goes to /api/ask and the SQL that comes back runs in the browser,
// in the answer area below the chips. The whole box is one console panel, dark in both themes
// with one fill and one cut; the form and the answer share it. The chips carry reviewed SQL and
// run it locally with no request. The answer area is always in the markup, so its status and
// error regions exist before anything is written to them; it takes up space only once it holds
// something.
// The examples are the fallback listed when the AI is out of reach; one of them carries a line
// shown under its table, which starts hidden and is revealed when that example runs. A page
// without the raw console (404) gets no Edit this query button, since there is nowhere to edit.
// After a typed question the site could not answer, the send block offers to pass the question
// on; nothing is sent unless its button is clicked, and the sentence under it takes the lifetime
// from the code.
// With example, the box sets the answer beside the form from 1200px, and until the first question
// or chip that pane shows an example answer: its SQL run here at build time against the built
// database and written into the page, so it needs no request and no script.
interface Props {
  editable?: boolean;
  example?: boolean;
}

const { editable = false, example = false } = Astro.props;
const database = dataFile('portfolio.sqlite');
const kb = Math.round(database.bytes / 1000);

// The way the browser's worker runs a query: the first statement, stepped up to one row past the
// cap, so the example shows what running its SQL in the browser would.
async function run(sql: string): Promise<Result> {
  const db = await openDatabase();
  const statement = db.prepare(sql);
  try {
    const rows: Cell[][] = [];
    while (rows.length < ROWS + 1 && statement.step()) rows.push(statement.get());
    return { columns: statement.getColumnNames(), rows, truncated: rows.length === ROWS + 1 };
  } finally {
    statement.free();
  }
}

const shown = example ? answerExample : undefined;
const answer = shown ? await run(shown.sql) : undefined;
---

<div class:list={['console cut ask', { 'ask-split': example }]} data-ask data-kb={kb} data-db-url={database.url}>
  <!-- Enter submits through the form. Its method makes the browser's own submission a no-op
       (there is no dialog around it), so a question typed before the script has loaded, or
       with scripts off, never lands in the URL; the submit event still fires for the script. -->
  <form class="ask-form" method="dialog" data-ask-form>
    <label class="ask-label" for="ask-input">Ask about Alex in plain English. The site writes SQL, and you can read it.</label>
    <div class="ask-row">
      <input class="input" id="ask-input" type="text" maxlength={QUESTION_LENGTH.max} autocomplete="off" data-ask-input />
      <button type="submit" class="button button-primary cut">Ask</button>
    </div>
    <ul class="ask-chips" role="list">
      {
        chips.map((chip) => (
          <li>
            <button type="button" class="button chip" data-sql={chip.sql} data-more={chip.more ? examples.indexOf(chip) : undefined}>
              {chip.label}
            </button>
          </li>
        ))
      }
    </ul>
    <p class="ask-privacy">Your question goes to an AI service to become SQL. This site never logs it.</p>
  </form>
  <div class="console ask-panel" data-ask-panel>
    {
      shown && answer && (
        <div class="ask-example-answer" data-ask-example>
          <p class="console-head" id="ask-example-answer-head">
            <span class="ask-head-question">
              <span>Example</span>{' '}
              <span class="console-dot" aria-hidden="true">·</span>{' '}
              <span>{shown.label}</span>
            </span>{' '}
            <span class="ask-head-status">{summary(answer)}</span>
          </p>
          <pre class="ask-sql">{sqlTokens(shown.sql).map(({ text, keyword }) => (keyword ? <span class="sql-keyword">{text}</span> : text))}</pre>
          {editable && (
            <button type="button" class="console-run" data-ask-edit data-sql={shown.sql}>
              Edit this query
            </button>
          )}
          <div class="console-results" role="region" aria-labelledby="ask-example-answer-head" tabindex="0">
            <table>
              <thead>
                <tr>
                  {answer.columns.map((column) => (
                    <th scope="col">{column}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {visibleRows(answer).map((row) => (
                  <tr>
                    {row.map((value, index) => {
                      const cell = renderCell(answer.columns[index] ?? '', value);
                      if (cell.kind === 'image') {
                        return (
                          <td>
                            <a href={cell.src}>
                              <img src={cell.src} alt={cell.alt} width={THUMB} height={THUMB} loading="lazy" />
                            </a>
                          </td>
                        );
                      }
                      if (cell.kind === 'link') {
                        return (
                          <td>
                            <a href={cell.href}>{cell.text}</a>
                          </td>
                        );
                      }
                      return <td class={cell.empty ? 'null' : undefined}>{cell.text}</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
    <p class="console-head" data-ask-head>
      <span class="ask-head-question" id="ask-question" data-ask-question></span>{' '}
      <span class="ask-head-status">
        <span id="ask-status" role="status" data-ask-status></span>{' '}
        <span data-ask-scroll-cue hidden><span class="console-dot" aria-hidden="true">·</span> scrollable</span>{' '}
        <span class="console-cursor" aria-hidden="true"></span>
      </span>
    </p>
    <!-- A refusal is answered by this line alone, with nothing on the status line, so it
         announces itself. -->
    <p class="ask-explanation" aria-live="polite" data-ask-explanation></p>
    <pre class="ask-sql" data-ask-sql></pre>
    {editable && <button type="button" class="console-run" data-ask-edit hidden>Edit this query</button>}
    <p class="console-error" role="alert" data-ask-error></p>
    <div class="console-results" role="region" aria-labelledby="ask-question ask-status" data-ask-results></div>
    {
      examples.map(
        (example, index) =>
          example.more && (
            <p class="ask-more" data-ask-more={index} hidden>
              <a href={example.more.href}>{example.more.link}</a>{example.more.rest}
            </p>
          ),
      )
    }
    <div class="ask-send" data-ask-send-block hidden>
      <button type="button" class="console-run" data-ask-send aria-describedby="ask-send-note">Send this question to Alex</button>
      <p class="ask-send-note" id="ask-send-note">Only if you choose: the question is kept for {keptFor(TTL.sentQuestion)} so I can add what's missing. Nothing else is sent.</p>
    </div>
    <!-- Focused when a send goes through, so the confirmation is read out where the button was. -->
    <p class="ask-sent" tabindex="-1" data-ask-sent hidden>Sent. Thanks.</p>
    <ul class="ask-fallback" role="list" data-ask-fallback hidden>
      {
        examples.map((example, index) => (
          <li>
            <button type="button" class="ask-example" data-sql={example.sql} data-more={example.more ? index : undefined}>
              {example.label}
            </button>
            <code>{example.sql}</code>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .ask {
    padding: var(--space-5);
  }

  /* The panel sets monospace for the answer; the question form keeps the page's type. */
  .ask-form {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    line-height: var(--leading-body);
  }

  .ask-label {
    display: block;
    margin-bottom: var(--space-3);
    font-weight: 600;
  }

  .ask-row {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .ask-row .input {
    flex: 1;
    min-width: 0;
  }

  /* One chip per line at every width, so the questions read down the form as a list. */
  .ask-chips {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
  }

  .ask-chips li {
    margin: 0;
    max-width: none;
  }

  .ask-privacy {
    margin: 0;
    color: var(--console-muted);
    font-size: var(--text-sm);
  }

  /* The answer area sits inside the box's own padding, so it has none. It keeps the console
     class for the cursor, which blinks while this element is working. Closed, its empty lines
     have no height, so nothing shows. */
  .ask-panel {
    margin-top: var(--space-4);
    padding: 0;
  }

  .ask-panel:not([data-open]) {
    margin: 0;
  }

  .ask-panel:not([data-open]) > .console-head {
    margin: 0;
  }

  /* The room the page leaves above or below the answer when it scrolls the answer into sight. Under
     the form it is the panel's own gap below the privacy note, so the note is never cut through. */
  .ask-panel,
  .ask-panel > .console-head {
    scroll-margin: var(--space-4);
  }

  /* Here the head line is the question, balanced like a heading, and under it the status with the
     cursor on a line of its own. While the panel is open that line keeps its height even with
     nothing on it, so the head does not grow or shrink as "working" gives way to the row count and
     nothing below it moves. The cursor stands on the text's baseline, as in the raw console. */
  .ask-panel .console-head {
    display: block;
  }

  .ask-head-question {
    display: block;
    text-wrap: balance;
  }

  .ask-head-status {
    display: block;
  }

  .ask-panel[data-open] .ask-head-status {
    min-height: calc(var(--leading-mono) * 1em);
  }

  .ask-panel .console-cursor {
    vertical-align: baseline;
  }

  /* The example only ever stands beside the form, so it shows nowhere below 1200px, and the first
     question or chip removes it. Its rows are part of the page, so they are there from the start
     rather than revealed one by one. */
  .ask-example-answer {
    display: none;
  }

  .ask-example-answer tbody tr {
    animation: none;
  }

  .ask-explanation,
  .ask-sql,
  .ask-more {
    margin: 0;
    max-width: none;
  }

  .ask-more {
    margin-top: var(--space-3);
  }

  .ask-send,
  .ask-sent {
    margin-top: var(--space-4);
  }

  /* The consent sentence reads like the privacy note under the form. */
  .ask-send-note {
    margin: var(--space-2) 0 0;
    color: var(--console-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .ask-sent {
    margin-bottom: 0;
  }

  .ask-explanation:not(:empty) {
    margin-bottom: var(--space-3);
  }

  /* The question is the visitor's and the explanation the model's, so a word longer than the line,
     such as a pasted address, breaks where it must instead of widening the page. */
  .ask-head-question,
  .ask-explanation {
    overflow-wrap: anywhere;
  }

  /* The SQL as it came back, wrapped rather than scrolled, in the console's ink with its
     keywords picked out; the code-block frame from the page styles does not apply here. */
  .ask-sql {
    padding: 0;
    border: 0;
    background: none;
    color: var(--console-ink);
    font-size: inherit;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .ask-sql:not(:empty) {
    margin-bottom: var(--space-3);
  }

  .ask-fallback {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .ask-fallback li {
    margin: 0;
    max-width: none;
  }

  .ask-fallback li + li {
    margin-top: var(--space-2);
  }

  /* Each label is a button that runs its SQL here; it reads as a link, at control height. */
  .ask-example {
    display: inline-flex;
    align-items: center;
    min-height: var(--control);
    padding: 0;
    border: 0;
    background: none;
    color: var(--console-ink);
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: 600;
    line-height: var(--leading-body);
    text-align: left;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition: text-decoration-color var(--duration) var(--ease);
  }

  @media (hover: hover) {
    .ask-example:hover {
      text-decoration-thickness: 2px;
      text-decoration-color: var(--console-accent);
    }
  }

  .ask-fallback code {
    display: block;
    color: var(--console-muted);
    overflow-wrap: anywhere;
  }

  @media (min-width: 1200px) {
    .ask {
      padding: var(--space-6);
    }

    /* Beside the form, the box is a subgrid of the page's twelve columns: the form takes 1 to 8
       and the answer 8 to 13. The box's padding only insets the two outer tracks, so the split
       stays on the page's column line 8. The console rules would place any panel in 1 to 8, hence
       the explicit columns. A 1px rule down the middle of the grid's gap parts the two panes. A
       browser without subgrid skips all of this and keeps the box whole, its answers opening under
       the form, with no example. */
    @supports (grid-template-columns: subgrid) {
      .ask-split {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: subgrid;
      }

      /* The answer pane is the taller side, so the privacy note goes to the foot of the form's
         column, level with the end of the pane, rather than leaving the space under it empty. */
      .ask-split .ask-form {
        display: flex;
        flex-direction: column;
        grid-column: 1 / 8;
      }

      .ask-split .ask-privacy {
        margin-top: auto;
      }

      /* After the first question or chip the pane keeps the example's height as its smallest
         height (begin() in console.ts records it as the example goes), so a short answer leaves
         the row, the privacy note and the work list where they were. */
      .ask-split .ask-panel {
        position: relative;
        grid-column: 8 / 13;
        min-height: var(--example-height, auto);
        margin: 0;
      }

      .ask-split .ask-panel::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: calc(var(--space-5) / -2);
        width: 1px;
        background: var(--console-rule);
      }

      .ask-split .ask-example-answer {
        display: block;
      }

      /* A long answer here would stretch the hero and push the work list down, so its rows scroll
         inside a box at most 25rem tall, the column names held at its top, while the question,
         status, SQL and buttons stay outside it. Only where the main pointer is a mouse or
         trackpad, since on a touch screen the box would take swipes meant for the page, and only
         on a window at least 42.5rem tall, so the box never fills more than 59% of it; everywhere
         else the answer grows as it does below 1200px. The scroll padding keeps a link that takes
         focus clear of the held header row at the top, and leaves room for its focus ring at the
         bottom. With separate borders each header cell draws its own rule, so the rule stays with
         the header while it is held. */
      @media (min-height: 42.5rem) and (hover: hover) and (pointer: fine) {
        .ask-split .console-results {
          max-height: 25rem;
          overflow: auto;
          scroll-padding-top: calc(var(--text-xs) * var(--leading-mono) + var(--space-2) * 3 + 1px);
          scroll-padding-bottom: var(--space-2);
        }

        .ask-split .console-results :global(table) {
          border-collapse: separate;
          border-spacing: 0;
        }

        .ask-split .console-results :global(th) {
          position: sticky;
          top: 0;
          background: var(--console-bg);
          white-space: nowrap;
        }
      }
    }
  }
</style>
