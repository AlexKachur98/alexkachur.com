---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string | undefined;
  // The width attribute, and the largest width the image takes unless a page stretches it.
  width: number;
  // The srcset for an image a page stretches; otherwise width and double it.
  widths?: number[];
  sizes: string;
  // For an image that is the largest thing in the first screen on some windows.
  eager?: boolean;
  // A second way to a page another link here already leads to: an empty link over the image, out
  // of the tab order and hidden from screen readers, so keyboard users meet that link once.
  href?: string;
}

const { src, alt, caption, width, sizes, eager = false, href } = Astro.props;
const target = Math.min(width, src.width);
// The source's ratio, so the image service scales and never crops.
const height = Math.round((target * src.height) / src.width);
const widths = [...new Set((Astro.props.widths ?? [target, target * 2]).map((candidate) => Math.min(candidate, src.width)))];
const image = {
  src,
  alt,
  width: target,
  height,
  widths,
  sizes,
  loading: eager ? ('eager' as const) : ('lazy' as const),
};
---

<figure>
  {
    href ? (
      <div class="linked">
        <Image {...image} />
        <a href={href} tabindex="-1" aria-hidden="true"></a>
      </div>
    ) : (
      <Image {...image} />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  /* Only as wide as the image, so the link never covers blank space beside it. */
  .linked {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }

  .linked a {
    position: absolute;
    inset: 0;
  }
</style>
