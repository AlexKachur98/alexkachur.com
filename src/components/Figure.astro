---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Every photo and screenshot: natural aspect ratio, 1px rule, muted caption, explicit
// width and height. width sets those attributes, and with them the largest width the image takes
// unless the page stretches it to fill a wider column. The srcset carries that width and double
// it for dense screens, or the widths given when the image is stretched; every candidate is
// capped at the source so nothing is upscaled. The height keeps the source ratio, so the image
// service scales and never crops. An eager figure is fetched first, for an image that is the
// largest thing in the first screen; every other image waits until it is near the viewport.
// With href, the image is also a way to a page some other link on this page already leads to:
// an empty link lies over it, out of the tab order and hidden from screen readers, so the image
// keeps its alt text and keyboard users meet that page's link once.
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string | undefined;
  width: number;
  widths?: number[];
  sizes: string;
  eager?: boolean;
  href?: string;
}

const { src, alt, caption, width, sizes, eager = false, href } = Astro.props;
const target = Math.min(width, src.width);
const height = Math.round((target * src.height) / src.width);
const widths = [...new Set((Astro.props.widths ?? [target, target * 2]).map((candidate) => Math.min(candidate, src.width)))];
const image = {
  src,
  alt,
  width: target,
  height,
  widths,
  sizes,
  loading: eager ? ('eager' as const) : ('lazy' as const),
  fetchpriority: eager ? ('high' as const) : undefined,
};
---

<figure>
  {
    href ? (
      <div class="linked">
        <Image {...image} />
        <a href={href} tabindex="-1" aria-hidden="true"></a>
      </div>
    ) : (
      <Image {...image} />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  /* Only as wide as the image, so the link never covers blank space beside it. */
  .linked {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }

  .linked a {
    position: absolute;
    inset: 0;
  }
</style>
