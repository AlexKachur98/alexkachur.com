---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Every photo and screenshot: natural aspect ratio, 1px rule, muted caption, explicit
// width and height. width sets those attributes, and with them the largest width the image takes
// unless the page stretches it to fill a wider column. The srcset carries that width and double
// it for dense screens, or the widths given when the image is stretched; every candidate is
// capped at the source so nothing is upscaled. The height keeps the source ratio, so the image
// service scales and never crops.
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string | undefined;
  width: number;
  widths?: number[];
  sizes: string;
}

const { src, alt, caption, width, sizes } = Astro.props;
const target = Math.min(width, src.width);
const height = Math.round((target * src.height) / src.width);
const widths = [...new Set((Astro.props.widths ?? [target, target * 2]).map((candidate) => Math.min(candidate, src.width)))];
---

<figure>
  <Image src={src} alt={alt} width={target} height={height} widths={widths} sizes={sizes} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
