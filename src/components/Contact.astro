---
import Section from './Section.astro';
import { siteFacts } from '../lib/facts.ts';
import { select } from '../lib/query.ts';

// The repo link goes to this site's own repository, the Portfolio site project's, not the profile.
const facts = await siteFacts();
const repo = (await select("SELECT repo_url FROM projects WHERE slug = 'this-site'")).rows[0]?.[0];
if (typeof repo !== 'string') throw new Error('the this-site project has no repo_url');
---

<Section id="contact" title="Contact">
  <p>Email is the fastest way to reach me: <a href={`mailto:${facts.email}`}>{facts.email}</a>. <a href={`https://${facts.linkedin}`}>LinkedIn</a> works too. If you found a bug on this site, the repo is on <a href={repo}>GitHub</a> and I would like to hear about it.</p>
</Section>
