---
// A page section. Its layout lives in base.css, so Markdown sections look the same. A section whose
// body renders to nothing, since all it holds is a TODO note the build strips, is left out whole.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const body = Astro.slots.has('default') ? (await Astro.slots.render('default')).trim() : '';
---

{
  body !== '' && (
    <section class="section" id={id}>
      <h2>{title}</h2>
      <Fragment set:html={body} />
    </section>
  )
}
