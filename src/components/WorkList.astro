---
import { getCollection } from 'astro:content';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import Figure from './Figure.astro';
import Section from './Section.astro';
import SplitRoofFlow from './SplitRoofFlow.astro';
import { projectPage } from '../lib/rows.ts';

// Rows separated by rules, never cards, every one laid out alike: the image takes four of the
// twelve columns from 768px and six from 1200px. A row shows its first screenshot, which fills
// the column from 1200px, so screenshots cropped to one ratio share one size; the sizes list
// follows the grid: fluid between 768px and 1080px and again between 1200px and the 1240px
// container, fixed at each container width, and held on a phone by the width attribute. The
// largest candidate is double the widest column, or the whole source where that is narrower.
// A row whose page shows no interface, or whose page is the write-up of the site, shows the
// drawing that page explains instead, named by the sentence its file gives it: the drawing keeps
// its natural width (the phone one below 768px, the wide one from 1200px) so its labels stay on
// the type scale, and between 768px and 1199px, where the column is too narrow for either, the
// row shows its text alone. No thumbnail carries a caption: the title and the card sentence are
// the row's words, and the case study shows the captions. The first screenshot loads eagerly,
// since on tall windows it is the largest thing in the first screen, with no raised fetch
// priority, because on most windows a line of the hero's text is; every other image waits until
// it is near the viewport. A thumbnail is a second way into the page for a pointer; hovering it or
// the title marks both, so the two read as one link.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const technologies = await getCollection('technologies');
const names = new Map(technologies.map((entry) => [entry.id, entry.data.name]));
const diagrams = { architecture: ArchitectureDiagram, 'splitroof-flow': SplitRoofFlow } as const;
const firstShot = projects.findIndex((project) => !project.data.row_image && project.data.screenshots.length > 0);

const rowWidths = [312, 660, 984, 1320];
const rowSizes =
  '(min-width: 1600px) 660px, (min-width: 1240px) 560px, (min-width: 1200px) calc(50vw - 60px), (min-width: 1080px) 312px, (min-width: 768px) calc(33.33vw - 48px), (min-width: 360px) 312px, calc(100vw - 48px)';
---

<Section id="work" title="Selected work">
  <ol class="work" role="list">
    {
      projects.map((project, index) => {
        const { name, card, role, year_start, screenshots, row_image } = project.data;
        const shot = row_image ? undefined : screenshots[0];
        const Diagram = row_image ? diagrams[row_image.diagram] : undefined;
        const page = projectPage(project.id, project.data.page);
        return (
          <li class="work-row grid">
            <div class="work-text">
              <h3>
                <a href={page}>{name}</a>
              </h3>
              <p>{card}</p>
              <p class="work-meta">
                {role} · {year_start}
              </p>
              <ul class="tags" role="list">
                {project.data.technologies.map((ref) => (
                  <li>{names.get(ref.id) ?? ref.id}</li>
                ))}
              </ul>
            </div>
            {shot && (
              <div class="work-shot">
                <Figure src={shot.src} alt={shot.alt} width={312} widths={rowWidths} sizes={rowSizes} eager={index === firstShot} href={page} />
              </div>
            )}
            {Diagram && row_image && (
              <div class="work-shot work-diagram">
                <div class="linked">
                  <Diagram title={row_image.alt} />
                  <a href={page} tabindex="-1" aria-hidden="true" />
                </div>
              </div>
            )}
          </li>
        );
      })
    }
  </ol>
</Section>

<style>
  .work {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A layout row, not prose: the 68ch measure that base.css puts on li does not apply. */
  .work-row {
    max-width: none;
    padding-block: var(--space-6);
    border-top: 1px solid var(--rule);
  }

  /* The section already draws the rule the title sits on. */
  .work-row:first-child {
    padding-top: 0;
    border-top: 0;
  }

  h3 {
    margin-bottom: var(--space-2);
  }

  /* A 40px hit area without growing the row: the margin gives back the padding. */
  h3 a {
    display: inline-block;
    padding-block: calc((var(--control) - var(--leading-heading) * 1em) / 2);
    margin-block: calc((var(--leading-heading) * 1em - var(--control)) / 2);
  }

  .work-meta {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-mono);
  }

  .work-shot :global(img) {
    transition: border-color var(--duration) var(--ease);
  }

  /* A drawing gets the frame and the overlay link a screenshot has; the component's figure keeps
     no margin of its own inside the row. */
  .work-diagram .linked {
    position: relative;
    width: fit-content;
    max-width: 100%;
    border: 1px solid var(--rule);
    transition: border-color var(--duration) var(--ease);
  }

  .work-diagram .linked a {
    position: absolute;
    inset: 0;
  }

  .work-diagram :global(figure) {
    margin: 0;
  }

  @media (hover: hover) {
    .work-row:has(h3 a:hover, .work-shot :global(a):hover) h3 a {
      text-decoration-thickness: 2px;
      text-decoration-color: var(--mark);
    }

    .work-row:has(h3 a:hover, .work-shot :global(a):hover) .work-shot :global(img),
    .work-row:has(h3 a:hover, .work-shot :global(a):hover) .work-diagram .linked {
      border-color: var(--mark);
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-mono);
  }

  @media (min-width: 768px) {
    .work-text {
      grid-column: 1 / 9;
    }

    .work-shot {
      grid-column: 9 / 13;
    }

    /* Four columns are too narrow for either drawing at its natural width. */
    .work-diagram {
      display: none;
    }
  }

  /* The img comes from Figure, so only :global reaches it; its width attribute would otherwise
     stop it short of the wider column, and the frame around it would stay as narrow. */
  @media (min-width: 1200px) {
    .work-text {
      grid-column: 1 / 7;
    }

    .work-shot {
      grid-column: 7 / 13;
    }

    .work-diagram {
      display: block;
    }

    .work-shot :global(.linked) {
      width: auto;
    }

    .work-shot :global(img) {
      width: 100%;
    }

    .work-diagram .linked {
      width: fit-content;
    }
  }
</style>
