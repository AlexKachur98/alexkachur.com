---
import AskBox from './AskBox.astro';
---

<section class="hero grid">
  <div class="hero-lead">
    <h1>Alex Kachur</h1>
    <p class="lead">I build full-stack web apps with an AI doing real work inside them.</p>
  </div>
  <div class="hero-ask">
    <AskBox editable />
  </div>
  <div class="hero-facts">
    <p class="status">Toronto, Canada. Final-year software engineering student at Centennial College. Open to full-stack and AI roles from May 2027.</p>
    <ul class="links" role="list">
      <li><a href="https://github.com/AlexKachur98">GitHub</a></li>
      <li><a href="https://linkedin.com/in/alex-kachur">LinkedIn</a></li>
      <li><a href="mailto:alexkachur98@gmail.com">Email</a></li>
      <li><a href="/Alex-Kachur-Resume.pdf">Resume</a></li>
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-8);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .lead {
    margin: 0;
  }

  /* A plain rule: the Ask button, the cursor while a question runs and the mark on the Selected
     work title are already the three yellow elements this first screen may hold. */
  .hero-facts {
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .status {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-mono);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control);
  }

  /* A grid item is never narrower than its content by default, so on a phone the input row or a
     wide results table would push the page sideways; at zero the table scrolls inside the box. */
  .hero-ask {
    min-width: 0;
  }

  /* From 768px the facts sit beside the headline and the Ask box takes its own row under it,
     so an answer growing in the box moves nothing beside it. */
  @media (min-width: 768px) {
    .hero {
      align-items: end;
      padding-top: var(--space-9);
    }

    .hero-lead {
      grid-row: 1;
      grid-column: 1 / 8;
    }

    .hero-facts {
      grid-row: 1;
      grid-column: 8 / 13;
    }

    .hero-ask {
      grid-row: 2;
      grid-column: 1 / 9;
    }
  }

  /* From 1200px the Ask box under the name ends where the line does, at column 8, so the two share
     one right edge. The first row aligns to its top, and the facts drop by the space between the
     top of the name's line and the tops of its capitals, worked out from the name's size, its line
     height and Barlow's metrics, so their rule is level with the capitals at every name size. The
     box keeps the second row to itself, so an answer growing in it moves nothing beside it. */
  @media (min-width: 1200px) {
    .hero {
      align-items: start;
    }

    .hero-facts {
      margin-top: calc(var(--text-3xl) * ((var(--leading-heading) + var(--barlow-ascent) - var(--barlow-descent)) / 2 - var(--barlow-cap-height)));
    }

    .hero-ask {
      grid-column: 1 / 8;
    }
  }
</style>
