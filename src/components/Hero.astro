---
import AskBox from './AskBox.astro';

const curl = `curl ${Astro.site!.origin}`;
---

<section class="hero grid">
  <div class="hero-id">
    <h1>Alex Kachur</h1>
    <p class="role"><strong>Full-stack &amp; AI developer.</strong> I build web apps with an AI doing real work inside them.</p>
    <p class="status">Toronto, Canada&nbsp;· Final-year Software Engineering Technology, Centennial College&nbsp;· Available <span class="no-wrap">full-time</span> May&nbsp;2027</p>
    <ul class="actions" role="list">
      <li>
        <a class="button" href="/Alex-Kachur-Resume.pdf" target="_blank" rel="noopener">Resume<span class="visually-hidden"> (PDF, opens in a new tab)</span></a>
      </li>
      <li><a href="mailto:alexkachur98@gmail.com">Email</a></li>
      <li><a href="https://github.com/AlexKachur98">GitHub</a></li>
      <li><a href="https://linkedin.com/in/alex-kachur">LinkedIn</a></li>
      <li><code>{curl}</code></li>
    </ul>
  </div>
  <div class="hero-ask">
    <!-- The panel has no visible title; this one is for moving through the page by headings. -->
    <h2 class="visually-hidden">Ask this site</h2>
    <AskBox editable example />
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-8);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .role {
    font-size: var(--text-role);
    line-height: var(--leading-role);
    text-wrap: balance;
  }

  .role strong {
    font-weight: 600;
  }

  .status {
    color: var(--muted);
  }

  /* A narrow phone would otherwise break the word at its hyphen. */
  .no-wrap {
    white-space: nowrap;
  }

  /* On a phone the links sit closer, so from 360px wide the resume button, arrow and all, keeps the
     other three on its row. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }

  .actions li {
    margin: 0;
    max-width: none;
  }

  .actions a:not(.button) {
    display: inline-flex;
    align-items: center;
    min-height: var(--control);
  }

  .actions code {
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  /* A grid item is never narrower than its content by default, so on a phone the input row or a
     wide results table would push the page sideways; at zero the table scrolls inside the box. */
  .hero-ask {
    min-width: 0;
  }

  /* One stack, then the Ask panel, in the order they are read. From 768px the stack takes columns
     1 to 9 and leaves the right side empty, and the panel takes the same columns on its own row,
     so an answer growing in it moves nothing above it. */
  @media (min-width: 768px) {
    .hero {
      padding-top: var(--space-9);
    }

    .hero-id,
    .hero-ask {
      grid-column: 1 / 9;
    }

    .actions {
      column-gap: var(--space-5);
    }
  }

  /* From 1200px the panel spans its row as a subgrid of all twelve columns: the form in 1 to 8 and
     the answer in 8 to 13, which shows an example until the first question or chip. A browser
     without subgrid keeps the panel whole in columns 1 to 9. */
  @media (min-width: 1200px) {
    @supports (grid-template-columns: subgrid) {
      .hero-ask {
        display: grid;
        grid-column: 1 / 13;
        grid-template-columns: subgrid;
      }
    }
  }
</style>
