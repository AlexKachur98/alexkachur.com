---
import { examples } from '../data/examples.ts';

// The example queries as buttons carrying their SQL, which the console runs when one is clicked.
// data-nosnippet sits on a div because Google honours it only on div, span and section.
---

<div data-nosnippet>
  <ul class="examples" role="list" data-examples>
    {
      examples.map((example) => (
        <li>
          <button type="button" class="button chip" data-sql={example.sql}>
            {example.label}
          </button>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .examples {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  li {
    margin: 0;
    max-width: none;
  }
</style>
