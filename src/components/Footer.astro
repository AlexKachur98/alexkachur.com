---
// The build and deployed readouts are baked here from build-info.json; the
// two counters arrive from /api/stats after load and are appended to the same line.
import buildInfo from '../generated/build-info.json';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  path: string;
}

const { path } = Astro.props;
const commit = buildInfo.commit.slice(0, 7);
const deployed = buildInfo.builtAt.slice(0, 10);
const links = [
  { href: '/', label: 'Home' },
  { href: '/uses', label: 'Uses' },
  { href: '/api', label: 'API' },
  { href: '/how-this-site-works', label: 'How this site works' },
  { href: '/humans.txt', label: 'humans.txt' },
];
---

<footer class="container site-footer">
  <p class="readouts" data-readouts>build {commit} · deployed {deployed}</p>
  <nav aria-label="Footer">
    <ul class="footer-links" role="list">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={href === path ? 'page' : undefined}>{label}</a>
          </li>
        ))
      }
      <li><ThemeToggle /></li>
    </ul>
  </nav>
  <p class="footer-line">Built by Alex Kachur in Toronto. No tracking beyond anonymous page views.</p>
</footer>

<style>
  .readouts {
    margin: 0 0 var(--space-4);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-mono);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    font-weight: 600;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control);
  }

  .footer-line {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
