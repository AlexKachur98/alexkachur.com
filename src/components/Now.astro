---
import { getEntry } from 'astro:content';
import Section from './Section.astro';

const page = await getEntry('pages', 'now');
if (!page?.data.title) throw new Error('src/content/pages/now.md is missing, or has no title');
---

<Section id="now" title={page.data.title}>
  <Fragment set:html={page.rendered?.html ?? ''} />
</Section>
