---
import Section from '../components/Section.astro';
import Base from '../layouts/Base.astro';
import { select } from '../lib/query.ts';

// The page shows the uses table as a visitor's query returns it, grouped under its sections in
// page order. A row whose details already begin with the item reads as the details alone.
const { rows } = await select('SELECT section, item, details FROM uses ORDER BY position');
const sections = new Map<string, string[]>();
for (const [section, item, details] of rows as string[][]) {
  sections.set(section!, [...(sections.get(section!) ?? []), details!.startsWith(item!) ? details! : `${item}: ${details}`]);
}
const updated = (await select("SELECT value FROM facts WHERE key = 'uses_updated'")).rows[0]?.[0];
---

<Base title="Uses" description="The machines, peripherals and software Alex Kachur uses, and what he is learning.">
  <main id="main" class="container">
    <header class="page-head">
      <h1>Uses</h1>
      {updated && <p class="updated">Last updated: {updated}</p>}
    </header>
    {
      [...sections].map(([section, lines]) => (
        <Section id={section.toLowerCase()} title={section}>
          <ul>
            {lines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </Section>
      ))
    }
  </main>
</Base>

<style>
  .page-head {
    padding-top: var(--space-8);
  }

  .updated {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-mono);
  }

  @media (min-width: 768px) {
    .page-head {
      padding-top: var(--space-9);
    }
  }
</style>
