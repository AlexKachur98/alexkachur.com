---
import Section from '../components/Section.astro';
import Base from '../layouts/Base.astro';
import { pageEntry } from '../lib/page-entry.ts';
import { select } from '../lib/query.ts';
import { usesQuery } from '../lib/uses-query.ts';

// The uses table as a visitor's query returns it, grouped by section. A row whose details already
// begin with the item shows the details alone, the item still bold. The query and the JSON link
// are marked data-nosnippet as interface text.
const page = await pageEntry('uses');
const lead = page.rendered?.html ?? '';
const { rows } = await select(usesQuery);
const sections = new Map<string, { item: string; rest: string }[]>();
for (const [section, item, details] of rows as string[][]) {
  const rest = details!.startsWith(item!) ? details!.slice(item!.length) : `: ${details}`;
  sections.set(section!, [...(sections.get(section!) ?? []), { item: item!, rest }]);
}
const updated = (await select("SELECT value FROM facts WHERE key = 'uses_updated'")).rows[0]?.[0];
---

<Base title="Uses" description="The machines, peripherals and software Alex Kachur uses, and what he is learning.">
  <main id="main" class="container">
    <header class="page-head">
      <h1>{page.data.title}</h1>
      <div class="lead"><Fragment set:html={lead} /></div>
      {updated && <p class="updated">Last updated: {updated}</p>}
      <div data-nosnippet>
        <pre><code>{usesQuery}</code></pre>
        <p class="rows-link">The same rows as JSON: <a href="/api/uses.json">/api/uses.json</a></p>
      </div>
    </header>
    {
      [...sections].map(([section, lines]) => (
        <Section id={section.toLowerCase()} title={section}>
          <ul>
            {lines.map((line) => (
              <li>
                <b>{line.item}</b>
                {line.rest}
              </li>
            ))}
          </ul>
        </Section>
      ))
    }
  </main>
</Base>

<style>
  .updated {
    margin: 0 0 var(--space-4);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-mono);
  }

  .rows-link {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  b {
    font-weight: 600;
  }
</style>
