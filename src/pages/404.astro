---
import simba from '../assets/cats/simba-05.webp';
import Figure from '../components/Figure.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Nothing at this address." description="The database does not have that page either. Try asking it something instead.">
  <main class="container">
    <header class="page-head">
      <h1>Nothing at this address.</h1>
      <p class="lead">The database does not have that page either. Try asking it something instead.</p>
    </header>
    <!-- Stage 8: the Ask box renders here. -->
    <!-- TODO-ALEX: the caption is mine; rewrite it or keep it. -->
    <div class="grid">
      <div class="photo">
        <Figure
          src={simba}
          alt="Simba mid-meow on a patterned rug, mouth wide open"
          caption="Simba, reacting to the URL you typed."
          width={480}
          sizes="(min-width: 768px) 480px, calc(100vw - 48px)"
        />
      </div>
    </div>
    <p class="home"><a href="/">Back to the home page</a></p>
  </main>
</Base>

<style>
  .page-head {
    padding-top: var(--space-8);
  }

  .photo {
    margin-top: var(--space-6);
  }

  .home {
    margin-top: var(--space-6);
    font-weight: 600;
  }

  .home a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control);
  }

  @media (min-width: 768px) {
    .page-head {
      padding-top: var(--space-9);
    }

    /* Six of the twelve columns, the 480px the figure is sized for. */
    .photo {
      grid-column: 1 / 7;
    }
  }
</style>
