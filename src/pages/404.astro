---
import AskBox from '../components/AskBox.astro';
import Figure from '../components/Figure.astro';
import Base from '../layouts/Base.astro';
import { pageEntry } from '../lib/page-entry.ts';
import { blockText } from '../lib/page-text.ts';

const page = await pageEntry('404');
const lead = page.rendered?.html ?? '';
const photo = page.data.images?.[0];
---

<Base title={page.data.title} description={blockText(lead)} noindex>
  <main id="main" class="container">
    <header class="page-head">
      <h1>{page.data.title}</h1>
      <div class="lead"><Fragment set:html={lead} /></div>
    </header>
    <div class="grid">
      <div class="ask-slot">
        <h2 class="visually-hidden">Ask this site</h2>
        <AskBox />
      </div>
      {
        photo && (
          <div class="photo">
            <Figure src={photo.src} alt={photo.alt} caption={photo.caption} width={480} sizes="(min-width: 768px) 480px, calc(100vw - 48px)" />
          </div>
        )
      }
    </div>
    <p class="home"><a href="/">Back to the home page</a></p>
  </main>
</Base>

<style>
  .home {
    margin-top: var(--space-6);
    font-weight: 600;
  }

  .home a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control);
  }

  /* As in the hero: lets a wide results table scroll inside the box on a phone. */
  .ask-slot {
    min-width: 0;
  }

  @media (min-width: 768px) {
    .ask-slot {
      grid-column: 1 / 9;
    }

    /* Six columns, the 480px its figure is sized for. */
    .photo {
      grid-column: 1 / 7;
    }
  }
</style>
