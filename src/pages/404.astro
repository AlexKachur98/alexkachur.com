---
import simba from '../assets/cats/simba-05.webp';
import AskBox from '../components/AskBox.astro';
import Figure from '../components/Figure.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Nothing at this address." description="The database does not have that page either. Try asking it something instead.">
  <main class="container">
    <header class="page-head">
      <h1>Nothing at this address.</h1>
      <p class="lead">The database does not have that page either. Try asking it something instead.</p>
    </header>
    <!-- TODO: the caption was drafted for me; rewrite it or keep it. -->
    <div class="grid">
      <div class="ask-slot">
        <AskBox />
      </div>
      <div class="photo">
        <Figure
          src={simba}
          alt="Simba mid-meow on a patterned rug, mouth wide open"
          caption="Simba, reacting to the URL you typed."
          width={480}
          sizes="(min-width: 768px) 480px, calc(100vw - 48px)"
        />
      </div>
    </div>
    <p class="home"><a href="/">Back to the home page</a></p>
  </main>
</Base>

<style>
  .page-head {
    padding-top: var(--space-8);
  }

  .home {
    margin-top: var(--space-6);
    font-weight: 600;
  }

  .home a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control);
  }

  /* A grid item is never narrower than its content by default, so on a phone the input row or a
     wide results table would push the page sideways; at zero the table scrolls inside the box. */
  .ask-slot {
    min-width: 0;
  }

  @media (min-width: 768px) {
    .page-head {
      padding-top: var(--space-9);
    }

    /* The Ask box takes the width it has on the home page; the photo sits under it at six of
       the twelve columns, the 480px the figure is sized for. */
    .ask-slot {
      grid-column: 1 / 9;
    }

    .photo {
      grid-column: 1 / 7;
    }
  }
</style>
