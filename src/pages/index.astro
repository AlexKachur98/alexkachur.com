---
import About from '../components/About.astro';
import Console from '../components/Console.astro';
import Contact from '../components/Contact.astro';
import Examples from '../components/Examples.astro';
import Hero from '../components/Hero.astro';
import Now from '../components/Now.astro';
import SchemaPanel from '../components/SchemaPanel.astro';
import Section from '../components/Section.astro';
import WorkList from '../components/WorkList.astro';
import Base from '../layouts/Base.astro';

const home = new URL('/', Astro.site).href;
// The WebSite node gives search results the site's name; the ProfilePage says the home page is
// about one person. The GitHub and LinkedIn addresses are the hero's links.
// TODO: add my photo as the Person image once I have it.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'Alex Kachur', alternateName: new URL(home).host, url: home },
    {
      '@type': 'ProfilePage',
      mainEntity: {
        '@type': 'Person',
        name: 'Alex Kachur',
        url: home,
        jobTitle: 'Full-stack & AI developer',
        description: 'Full-stack & AI developer. I build web apps with an AI doing real work inside them.',
        sameAs: ['https://github.com/AlexKachur98', 'https://linkedin.com/in/alex-kachur'],
      },
    },
  ],
};
---

<Base
  title="Alex Kachur · Full-stack & AI developer"
  description="Full-stack & AI developer in Toronto. I build web apps with an AI doing real work inside them. Available full-time from May 2027."
  ogTitle="Full-stack & AI developer"
  structuredData={structuredData}
>
  <main id="main" class="container">
    <Hero />
    <WorkList />
    <Section id="query" title="Query this site">
      <p>Everything on this site is generated from one small database. It is loaded into your browser and nothing you type leaves it. Read-only, SQLite.</p>
      <Examples />
      <div class="grid query">
        <Console />
        <SchemaPanel />
      </div>
    </Section>
    <About />
    <Now />
    <Contact />
  </main>
</Base>

<style>
  /* The console keeps its own height beside the schema list rather than stretching to it. */
  .query {
    align-items: start;
  }
</style>
