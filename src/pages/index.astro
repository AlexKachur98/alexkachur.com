---
import About from '../components/About.astro';
import Console from '../components/Console.astro';
import Contact from '../components/Contact.astro';
import Examples from '../components/Examples.astro';
import Hero from '../components/Hero.astro';
import Now from '../components/Now.astro';
import SchemaPanel from '../components/SchemaPanel.astro';
import Section from '../components/Section.astro';
import WorkList from '../components/WorkList.astro';
import Base from '../layouts/Base.astro';
import { availableMonth, siteFacts } from '../lib/facts.ts';

const home = new URL('/', Astro.site).href;
const facts = await siteFacts();
const { month, year } = availableMonth(facts);
// The city alone, as the description says where Alex works: the location fact is "city, country".
const city = facts.location.split(', ')[0];
// The WebSite node gives search results the site's name; the ProfilePage says the home page is
// about one person. The GitHub and LinkedIn addresses are the hero's links.
// TODO: add my photo as the Person image once I have it.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: facts.name, alternateName: new URL(home).host, url: home },
    {
      '@type': 'ProfilePage',
      mainEntity: {
        '@type': 'Person',
        name: facts.name,
        url: home,
        jobTitle: facts.role,
        description: `${facts.role}. ${facts.headline}`,
        sameAs: [`https://${facts.github}`, `https://${facts.linkedin}`],
      },
    },
  ],
};
---

<Base
  title={`${facts.name} · ${facts.role}`}
  description={`${facts.role} in ${city}. ${facts.headline} Available full-time from ${month} ${year}.`}
  ogTitle={facts.role}
  structuredData={structuredData}
>
  <main id="main" class="container">
    <Hero />
    <WorkList />
    <Section id="query" title="Query this site">
      <p>All the content on this site comes from one small database. It is loaded into your browser and nothing you type leaves it. Read-only, SQLite.</p>
      <Examples />
      <div class="grid query">
        <Console />
        <SchemaPanel />
      </div>
    </Section>
    <About />
    <Now />
    <Contact />
  </main>
</Base>

<style>
  /* The console keeps its own height beside the schema list rather than stretching to it. */
  .query {
    align-items: start;
  }
</style>
