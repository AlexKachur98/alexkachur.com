---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import Section from '../components/Section.astro';
import Base from '../layouts/Base.astro';
import buildInfo from '../generated/build-info.json';
import numbers from '../generated/numbers.json';
import { dataFile } from '../lib/data-file.ts';
import { BOOTSTRAP_BUDGET_BYTES, INSIGHTS, loadedScripts } from '../lib/loaded-scripts.ts';
import { fillPlaceholders, group } from '../lib/numbers.ts';
import { pageEntry } from '../lib/page-entry.ts';
import { siteRepo } from '../lib/query.ts';
import { splitSections } from '../lib/sections.ts';

// The prose is the page entry, the text the sections table holds. What only this page adds is
// marked data-page-only, so the build test can compare the rest with the table. The model's name
// is read from /api/stats after load rather than baked, so it follows the variable. The build
// script's name links to its source at the commit the site was built from, so the link lasts.
const page = await pageEntry('how-this-site-works');
const where = 'pages/how-this-site-works.md';
const [lead, ...sections] = splitSections(page.rendered?.html ?? '', { lead: page.data.title }).map((section) => ({
  ...section,
  body: fillPlaceholders(section.body, numbers, `${where} ${section.title}`),
}));
if (!lead || lead.id !== '') throw new Error(`${where}: the text before the first heading is the lead, and it is missing`);
const dump = dataFile('portfolio.sql');
const scripts = loadedScripts();

const repo = await siteRepo();
const commit = /^[0-9a-f]{7,40}$/.test(buildInfo.commit) ? buildInfo.commit : 'main';
const source = (path: string) => `${repo}/blob/${commit}/${path}`;
const linked = (html: string, path: string) => html.replace(path, `<a href="${source(path)}">${path}</a>`);

// The first lines of the plain-text resume curl gets, cut the way the /api samples are.
const resumeHead = `${readFileSync(join(process.cwd(), 'public', 'resume.txt'), 'utf8').split('\n').slice(0, 7).join('\n')}\n...`;
---

<Base title={page.data.title} description="How alexkachur.com works: a database built at deploy time, an AI that writes SQL your browser runs, a public API and a capped AI budget.">
  <main id="main" class="container">
    <header class="page-head">
      <h1>{page.data.title}</h1>
      <div class="lead"><Fragment set:html={lead.body} /></div>
    </header>
    <dl class="facts" data-page-only>
      <dt>Tables</dt>
      <dd>{numbers.table_count}</dd>
      <dt>Model calls a month, at most</dt>
      <dd>{numbers.monthly_cap}</dd>
      <dt>Tokens a question sends</dt>
      <dd>{numbers.prompt_tokens}</dd>
      <dt>A month at the cap, at most</dt>
      <dd>{numbers.cap_month_cost}</dd>
      <dt>Eval questions on every push</dt>
      <dd>{numbers.eval_questions}</dd>
    </dl>
    {
      sections.map((section) => (
        <Section id={section.id} title={section.title}>
          {section.id === 'architecture' && <ArchitectureDiagram />}
          <Fragment set:html={section.id === 'build-time-database' ? linked(section.body, 'scripts/build-db.ts') : section.body} />
          {section.id === 'architecture' && (
            <Fragment>
              <pre data-page-only><code>curl -A curl/8.0 https://alexkachur.com</code></pre>
              <p data-page-only>The first lines of what comes back:</p>
              <pre data-page-only><code>{resumeHead}</code></pre>
            </Fragment>
          )}
          {section.id === 'build-time-database' && (
            <p data-page-only>
              <a href={dump.url}>
                <code>/data/portfolio.sql</code>
              </a>
            </p>
          )}
          {section.id === 'the-ask-pipeline' && (
            <p data-page-only hidden data-model-line>
              Right now it is <span data-model />.
            </p>
          )}
          {section.id === 'what-the-validator-rejects-and-why' && (
            <p data-page-only>
              If you find a hole in any of this, <a href={source('SECURITY.md')}>SECURITY.md</a> in the repository says how to tell me.
            </p>
          )}
          {section.id === 'cost-and-the-cap' && (
            <ul data-page-only>
              <li>
                Input: {numbers.monthly_cap} calls of {numbers.prompt_tokens} tokens, {numbers.month_input_tokens} tokens at {numbers.price_input} per million, {numbers.month_input_cost}.
              </li>
              <li>
                Output: at most {numbers.max_output_tokens} tokens a call, {numbers.month_output_tokens} tokens at {numbers.price_output} per million, {numbers.month_output_cost}.
              </li>
              <li>
                Together {numbers.cap_month_cost}. Measured on {numbers.fixture_model} at prompt version {numbers.fixture_prompt_version}; the recorded answers ran from {numbers.output_tokens_min} to {numbers.output_tokens_max} tokens.
              </li>
            </ul>
          )}
          {section.id === 'performance' && scripts && (
            <ul data-page-only>
              {scripts.map((script) => (
                <li>
                  <code>{script.name}</code>, {group(script.bytes)} bytes gzipped: {script.job}.
                </li>
              ))}
              <li>
                <code>{INSIGHTS.name}</code>, {group(INSIGHTS.bytes)} bytes as Vercel served it on {INSIGHTS.measured}: the page-count beacon the module above adds.
              </li>
              <li>
                The tests, and so CI, fail if the bootstrap reaches {group(BOOTSTRAP_BUDGET_BYTES)} bytes gzipped. The sizes are gzipped at zlib's default level, so a browser's Size column, which counts headers or the raw bytes, shows other figures.
              </li>
            </ul>
          )}
        </Section>
      ))
    }
  </main>
</Base>

<style>
  /* The model's name comes from a setting, so a long one breaks where it must rather than
     widening the page. */
  [data-model] {
    overflow-wrap: anywhere;
  }
</style>
