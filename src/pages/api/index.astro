---
import Base from '../../layouts/Base.astro';
import BreakablePath from '../../components/BreakablePath.astro';
import { tables } from '../../content/schemas.ts';
import schema from '../../generated/schema.json';
import { chips, storageQuery } from '../../data/examples.ts';
import { endpointId, endpoints, tableEndpoints } from '../../lib/endpoints.ts';
import type { TableName } from '../../content/schemas.ts';
import { previewJson } from '../../lib/preview-json.ts';
import { SEND, SEND_DESCRIPTION } from '../../lib/ask/send.ts';
import { select } from '../../lib/query.ts';
import { ASK_DESCRIPTION, openApiDocument, PROJECT_DESCRIPTION, RATE_LIMITS_SENTENCE, RESUME_DESCRIPTION, SCHEMA_DESCRIPTION, STATS_DESCRIPTION } from '../../lib/openapi.ts';
import buildInfo from '../../generated/build-info.json';
import recorded from '../../data/api-samples.json';

// The on-demand endpoints show the fields of their 200 body and every status they answer, read
// from the same OpenAPI document /api/openapi.json serves, so no value is typed in twice.
type Shape = { properties?: Record<string, { type?: string | string[]; description?: string; const?: unknown; enum?: unknown[] }>; $ref?: string };
type Operation = { responses: Record<string, { description: string; content?: { 'application/json'?: { schema: Shape } } }> };
const document = openApiDocument(schema, { site: Astro.site!.origin, version: buildInfo.commit });
const shapes = document.components.schemas as Record<string, Shape>;
const shapeOf = (ref: string): Shape => shapes[ref.split('/').pop()!]!;
function bodyOf(response: Operation['responses'][string]): string {
  const body = response.content?.['application/json']?.schema;
  if (!body) return '';
  const shape = body.$ref ? shapeOf(body.$ref) : body;
  const entries = Object.entries(shape.properties ?? {});
  const [name, only] = entries.length === 1 ? entries[0]! : [];
  if (only?.enum) return `${name}: ${only.enum.join(', ')}`;
  if (only?.const !== undefined) return `${name}: ${String(only.const)}`;
  return entries.map(([field]) => field).join(', ');
}
const fieldsOf = (ref: string) => Object.entries(shapeOf(ref).properties ?? {}).map(([name, field]) => ({ name, type: [field.type].flat().join(' or '), description: field.description ?? '' }));
const statusesOf = (path: string) => {
  const operation = Object.values(document.paths[path] as Record<string, Operation>)[0]!;
  return Object.entries(operation.responses).map(([status, response]) => ({ status, body: bodyOf(response), meaning: response.description }));
};
const shapesShown: Record<string, string> = { '/api/ask': 'ask_answer', '/api/questions': 'send_answer', '/api/stats': 'stats' };
import { queryOf, resumeData, resumeJson } from '../../lib/resume.ts';
import { openDatabase } from '../../lib/ask/db.ts';

// The example responses are cut from the same rows the endpoints serve.
// A table's rows as its endpoint serves them, and how many the page shows of each.
async function tableRows(table: TableName) {
  const { columns, rows } = await select(`SELECT * FROM ${table} ORDER BY rowid`);
  return rows.map((row) => Object.fromEntries(columns.map((name, index) => [name, row[index]])));
}
const first = (await tableRows('projects'))[0]!;
const stack = await select(
  `SELECT t.name FROM project_technologies pt JOIN technologies t ON t.id = pt.technology_id WHERE pt.project_id = ${Number(first.id)} ORDER BY t.id`,
);
const single = { ...first, technologies: stack.rows.map(([name]) => name) };
const resume = resumeJson(resumeData(queryOf(await openDatabase())), Astro.site!.origin);

const url = (path: string) => new URL(path, Astro.site).href;
const shownRows: Partial<Record<TableName, number>> = { projects: 1, pets: 1, technologies: 3, sections: 1, experience: 1 };
// What is stored: the storage table itself, run at build time, under the query that reads it.
const storage = await select(storageQuery);
const question = chips[0]!.label;

// A curl line and a truncated response for each path in the shared endpoint list. The two
// on-demand endpoints whose bodies carry live values show a response recorded from the deployed
// site on the day given, since the build cannot know those numbers.
const minutes = SEND.windowSeconds / 60;
// The recorded ask must answer the question the curl line sends, or the page would show a reply to something else.
if (recorded.ask.question !== question) throw new Error(`the recorded /api/ask sample answers "${recorded.ask.question}", not the page's example "${question}"`);
const samples: Record<string, { curl: string; response: string; description?: string; recorded?: string; note?: string }> = {
  ...Object.fromEntries(await Promise.all(tableEndpoints.map(async ({ path, rows }) => [path, { curl: `curl ${url(path)}`, response: previewJson(await tableRows(rows), { items: shownRows[rows] ?? 2 }) }]))),
  '/api/projects/{slug}.json': { curl: `curl ${url(`/api/projects/${first.slug}.json`)}`, description: PROJECT_DESCRIPTION, response: previewJson(single) },
  '/api/schema.json': { curl: `curl ${url('/api/schema.json')}`, description: SCHEMA_DESCRIPTION, response: previewJson(schema, { items: 1, chars: 60 }) },
  '/api/resume.json': { curl: `curl ${url('/api/resume.json')}`, description: RESUME_DESCRIPTION, response: previewJson(resume, { items: 1, chars: 60 }) },
  '/api/ask': {
    curl: `curl -X POST ${url('/api/ask')} -H 'content-type: application/json' -d '${JSON.stringify({ question })}'`,
    description: ASK_DESCRIPTION,
    response: previewJson(recorded.ask.body),
    recorded: recorded.ask.recorded,
  },
  '/api/questions': {
    curl: `curl -X POST ${url('/api/questions')} -H 'content-type: application/json' -d '${JSON.stringify({ question: 'A question the site could not answer', token: 'TOKEN' })}'`,
    description: SEND_DESCRIPTION,
    response: previewJson({ sent: true }),
    note: 'Replace TOKEN with the token /api/ask returned for that question.',
  },
  '/api/stats': { curl: `curl ${url('/api/stats')}`, description: STATS_DESCRIPTION, response: previewJson(recorded.stats.body), recorded: recorded.stats.recorded },
};

const docs = endpoints.map((endpoint) => {
  const sample = samples[endpoint.path];
  if (!sample) throw new Error(`${endpoint.path} has no example on this page`);
  const shown = shapesShown[endpoint.path];
  return {
    ...endpoint,
    description: endpoint.rows ? tables[endpoint.rows].description : undefined,
    ...sample,
    fields: shown ? fieldsOf(`#/components/schemas/${shown}`) : undefined,
    statuses: shown ? statusesOf(endpoint.path) : undefined,
  };
});
for (const path of Object.keys(samples)) {
  if (!endpoints.some((endpoint) => endpoint.path === path)) throw new Error(`${path} is not in the endpoint list`);
}
---

<Base title="API" description="Alex Kachur's public JSON API: the records this site is built from, and an endpoint that turns plain-English questions into SQL.">
  <main id="main" class="container">
    <header class="page-head">
      <h1>API</h1>
      <p class="lead">Everything on this site is data first. These endpoints return the same records the pages are built from. All of them are static JSON generated at build time, except /api/ask, which turns a question into SQL, /api/questions, which passes on a question a visitor chose to send, and /api/stats, which reports the counters.</p>
      <p>{RATE_LIMITS_SENTENCE} Every 429 carries a Retry-After header with the seconds to wait before you try again. /api/questions also returns 429 with error "daily_cap" once the day's {SEND.dailyCap} sent questions are used up. A question to /api/ask is cached for a month by its wording, so repeat questions are free. The monthly cap counts model calls, not questions, in the UTC calendar month.</p>
      <p>Try it:</p>
      <pre><code>curl {url('/api/projects.json')}</code></pre>
      <p>The whole API as an OpenAPI 3.1 document, built from the same schema and endpoint list, for loading into any client: <a href="/api/openapi.json">/api/openapi.json</a></p>
      <nav aria-label="Endpoints">
        <ul class="index" role="list">
          {docs.map((endpoint) => (
            <li>
              <a href={`#${endpointId(endpoint.path)}`} aria-label={`${endpoint.method} ${endpoint.path}`}>
                {endpoint.method} <BreakablePath path={endpoint.path} />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    {
      docs.map((endpoint) => (
        <section class="section endpoint" id={endpointId(endpoint.path)}>
          <h2 aria-label={`${endpoint.method} ${endpoint.path}`}>
            {endpoint.method} <BreakablePath path={endpoint.path} />
          </h2>
          {endpoint.description ? (
            <p>{endpoint.description}</p>
          ) : (
            <Fragment>
              <!-- TODO: write one sentence describing this endpoint. -->
            </Fragment>
          )}
          <pre><code>{endpoint.curl}</code></pre>
          {endpoint.note && <p class="recorded">{endpoint.note}</p>}
          {endpoint.fields && endpoint.statuses && (
            <Fragment>
              <p class="label">The fields of a 200 body:</p>
              <div class="wide" role="region" aria-label={`Fields of the ${endpoint.path} body`} tabindex="0">
                <table class="shape">
                  <thead>
                    <tr>
                      <th scope="col">field</th>
                      <th scope="col">type</th>
                      <th scope="col">meaning</th>
                    </tr>
                  </thead>
                  <tbody>
                    {endpoint.fields.map((field) => (
                      <tr>
                        <td>{field.name}</td>
                        <td>{field.type}</td>
                        <td>{field.description}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="label">Every status it answers:</p>
              <div class="wide" role="region" aria-label={`Statuses of ${endpoint.path}`} tabindex="0">
                <table class="shape">
                  <thead>
                    <tr>
                      <th scope="col">status</th>
                      <th scope="col">body</th>
                      <th scope="col">meaning</th>
                    </tr>
                  </thead>
                  <tbody>
                    {endpoint.statuses.map((row) => (
                      <tr>
                        <td>{row.status}</td>
                        <td>{row.body}</td>
                        <td>{row.meaning}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </Fragment>
          )}
          {endpoint.path === '/api/ask' && (
            <Fragment>
              <p>Each answer also carries a token: to send that question to Alex, pass it to /api/questions within {minutes} minutes.</p>
              <h3 id="what-is-stored">What is stored</h3>
              <pre><code>{storageQuery}</code></pre>
              <div class="stored" role="region" aria-labelledby="what-is-stored" tabindex="0">
                <table>
                  <thead>
                    <tr>
                      {storage.columns.map((column) => (
                        <th scope="col">{column}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {storage.rows.map((row) => (
                      <tr>
                        {row.map((cell) => (
                          <td>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p>Everything in the table but the theme choice is held in Upstash Redis.</p>
              <p>Your address is scrambled with a keyed hash (HMAC-SHA-256) before anything is stored: a plain hash of an address could be reversed by hashing every address in turn, but without the site's secret key the stored value cannot be matched back to an address.</p>
              <p>One line per failed request: status, error type, request ID and timing, written to Vercel's logs. Never the question or your address.</p>
              <p>Anthropic, which runs the model, receives the question and, under its <a href="https://privacy.claude.com/en/articles/7996866-how-long-do-you-store-my-organization-s-data">data retention policy</a>, deletes API inputs and outputs within 30 days, or keeps them up to 2 years if its safety systems flag a request; it does not train on them, since this site's account has not opted in to share data.</p>
              <p>Vercel, which hosts the site, keeps its request logs, that failed-request line included, for one hour on this site's plan, and counts page views for Web Analytics without cookies, discarding the visitor hash after 24 hours.</p>
            </Fragment>
          )}
          <pre><code>{endpoint.response}</code></pre>
          {endpoint.recorded && <p class="recorded">A sample from {endpoint.recorded}.</p>}
        </section>
      ))
    }
  </main>
</Base>

<style>
  .page-head {
    padding-top: var(--space-8);
  }

  /* A method and a path are data, so the endpoint titles are mono. A path breaks only after one of
     its slashes, never inside a name, and on a phone the titles take the body size so most fit on
     one line. */
  .endpoint h2 {
    font-family: var(--font-mono);
    font-size: var(--text-md);
  }

  /* The table of what is stored, and the field and status tables, can be wider than a phone, so
     each scrolls inside its own box. */
  .stored,
  .wide {
    overflow-x: auto;
  }

  .shape td:first-child,
  .shape td:nth-child(2) {
    white-space: nowrap;
  }

  /* The line naming each table, in the caption style, with room above it after the block before. */
  .label {
    margin: var(--space-5) 0 var(--space-2);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .wide {
    margin-bottom: var(--space-4);
  }

  /* The day a recorded sample was taken, or the note under a curl line, in the caption style. */
  .recorded {
    margin-top: calc(-1 * var(--space-2));
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* The endpoint index: one line per endpoint in the mono the titles use, so the on-demand
     endpoints at the foot of the page are reachable from the first screen. */
  .index {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-mono);
  }

  .index a {
    display: inline-block;
    padding-block: calc((var(--control) - var(--leading-mono) * 1em) / 2);
    margin-block: calc((var(--leading-mono) * 1em - var(--control)) / 2);
  }

  /* A heading inside an endpoint's section stays at the body size, below the endpoint title's, and a
     link to it stops a little above it rather than at the screen's edge. */
  .endpoint h3 {
    margin: var(--space-5) 0 var(--space-2);
    font-size: var(--text-md);
    scroll-margin-top: var(--space-5);
  }

  @media (min-width: 768px) {
    .page-head {
      padding-top: var(--space-9);
    }

    .endpoint h2 {
      font-size: var(--text-lg);
    }
  }
</style>
