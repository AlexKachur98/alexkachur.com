---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { tables } from '../../content/schemas.ts';
import schema from '../../generated/schema.json';
import { chips } from '../../data/examples.ts';
import { endpoints } from '../../lib/endpoints.ts';
import { previewJson } from '../../lib/preview-json.ts';
import { petRows, projectRows, projectTechnologyRows, technologyRows, timelineRows } from '../../lib/rows.ts';

// The example responses are cut from the same rows the endpoints serve.
const [projects, technologies, timeline, pets] = await Promise.all([
  getCollection('projects'),
  getCollection('technologies'),
  getCollection('timeline'),
  getCollection('pets'),
]);
const projectList = projectRows(projects);
const technologyList = technologyRows(technologies);
const names = new Map(technologyList.map((row) => [row.id, row.name]));
const first = projectList[0]!;
const single = {
  ...first,
  technologies: projectTechnologyRows(projects, technologies)
    .filter((link) => link.project_id === first.id)
    .map((link) => names.get(link.technology_id)),
};

const url = (path: string) => new URL(path, Astro.site).href;
const question = chips[0]!.label;

// A curl line and a truncated response for each path in the shared endpoint list.
const samples: Record<string, { curl: string; response?: string }> = {
  '/api/projects.json': { curl: `curl ${url('/api/projects.json')}`, response: previewJson(projectList, { items: 1 }) },
  '/api/projects/{slug}.json': { curl: `curl ${url(`/api/projects/${first.slug}.json`)}`, response: previewJson(single) },
  '/api/technologies.json': { curl: `curl ${url('/api/technologies.json')}`, response: previewJson(technologyList, { items: 3 }) },
  '/api/timeline.json': { curl: `curl ${url('/api/timeline.json')}`, response: previewJson(timelineRows(timeline), { items: 2 }) },
  '/api/pets.json': { curl: `curl ${url('/api/pets.json')}`, response: previewJson(petRows(pets), { items: 1 }) },
  '/api/schema.json': { curl: `curl ${url('/api/schema.json')}`, response: previewJson(schema, { items: 1, chars: 60 }) },
  '/api/ask': { curl: `curl -X POST ${url('/api/ask')} -H 'content-type: application/json' -d '${JSON.stringify({ question })}'` },
  '/api/stats': { curl: `curl ${url('/api/stats')}` },
};

const docs = endpoints.map((endpoint) => {
  const sample = samples[endpoint.path];
  if (!sample) throw new Error(`${endpoint.path} has no example on this page`);
  return { ...endpoint, description: endpoint.rows ? tables[endpoint.rows].description : undefined, ...sample };
});
for (const path of Object.keys(samples)) {
  if (!endpoints.some((endpoint) => endpoint.path === path)) throw new Error(`${path} is not in the endpoint list`);
}
---

<Base title="API" description="Alex Kachur's public JSON API: the records this site is built from, and an endpoint that turns plain-English questions into SQL.">
  <main id="main" class="container">
    <header class="page-head">
      <h1>API</h1>
      <p class="lead">Everything on this site is data first. These endpoints return the same records the pages are built from. All of them are static JSON generated at build time, except /api/ask, which turns a question into SQL, and /api/stats, which reports the counters. Rate limits: 10 questions a minute per connection and a monthly cap; when the cap is reached the endpoint returns 503 with reason "budget".</p>
      <p>A question to /api/ask is cached for a month by its wording, so repeat questions are free. The monthly cap counts model calls, not questions, in the UTC calendar month.</p>
      <p>Try it:</p>
      <pre><code>curl {url('/api/projects.json')}</code></pre>
      <p>The whole API as an OpenAPI 3.1 document, built from the same schema and endpoint list, for loading into any client: <a href="/api/openapi.json">/api/openapi.json</a></p>
    </header>
    {
      docs.map((endpoint) => (
        <section class="section endpoint" id={endpoint.path.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '')}>
          <!-- Chrome names the heading with a space at each <wbr>, so the label gives the path as written. -->
          <h2 aria-label={`${endpoint.method} ${endpoint.path}`}>
            {endpoint.method} /{endpoint.path.split('/').slice(1).map((part, index, parts) => (index < parts.length - 1 ? <>{part}/<wbr /></> : part))}
          </h2>
          {endpoint.description ? (
            <p>{endpoint.description}</p>
          ) : (
            <Fragment>
              <!-- TODO: write one sentence describing this endpoint. -->
            </Fragment>
          )}
          <pre><code>{endpoint.curl}</code></pre>
          {endpoint.path === '/api/ask' && (
            <Fragment>
              <h3 id="what-is-stored">What is stored</h3>
              <p>The cache and the counters are held in Upstash Redis.</p>
              <ul>
                <li>The SQL and the model's one-line explanation for a question, cached for a month (a refusal for a day) under a SHA-256 hash of the question. The question itself is never stored, though the cached SQL can repeat words from it.</li>
                <li>A counter keyed by a scrambled form of your address, kept for about two minutes, for the rate limit.</li>
                <li>Two monthly totals: questions answered and model calls, for the footer and the monthly cap.</li>
                <li>One line per failed request: status, error type, request ID and timing. Never the question or your address.</li>
                <li>Anthropic, which runs the model, receives the question and keeps API requests for a limited time under <a href="https://privacy.claude.com/en/articles/7996866-how-long-do-you-store-my-organization-s-data">its own policy</a>; it does not train on them, since this site's account has not opted in to share data.</li>
                <li>Vercel, which hosts the site, keeps its own request logs.</li>
              </ul>
            </Fragment>
          )}
          {endpoint.response ? (
            <pre><code>{endpoint.response}</code></pre>
          ) : (
            <Fragment>
              <!-- TODO: record an example response for this endpoint from the deployed site; its numbers cannot be baked at build without making them up. -->
            </Fragment>
          )}
        </section>
      ))
    }
  </main>
</Base>

<style>
  .page-head {
    padding-top: var(--space-8);
  }

  /* A method and a path are data, so the endpoint titles are mono. A path breaks only after one of
     its slashes, never inside a name, and on a phone the titles take the body size so most fit on
     one line. */
  .endpoint h2 {
    font-family: var(--font-mono);
    font-size: var(--text-md);
  }

  /* A heading inside an endpoint's section stays at the body size, below the endpoint title's, and a
     link to it stops a little above it rather than at the screen's edge. */
  .endpoint h3 {
    margin: var(--space-5) 0 var(--space-2);
    font-size: var(--text-md);
    scroll-margin-top: var(--space-5);
  }

  @media (min-width: 768px) {
    .page-head {
      padding-top: var(--space-9);
    }

    .endpoint h2 {
      font-size: var(--text-lg);
    }
  }
</style>
