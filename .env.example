#Read by /api/ask, /api/questions and /api/stats, and by the eval and questions scripts.
#Copy this file to .env for local work. In production the values are set in Vercel and apply
#from the next deployment.

#Required by /api/ask, and by npm run eval:record and npm run eval:live.
ANTHROPIC_API_KEY=

#Required by /api/ask and /api/questions: a long random string that keys the hash of each
#visitor's address and the signing of send tokens.
ASK_RATE_LIMIT_SECRET=

#Optional. The model /api/ask and the eval call, claude-haiku-4-5 when unset.
ANTHROPIC_MODEL=

#Optional. Model calls allowed per month as a whole number, 2000 when unset; 0 turns asking off.
ASK_MONTHLY_CAP=

#Redis for the rate limits, the monthly counters, the answer cache and sent questions. Either
#pair works: Upstash's names or the Vercel Marketplace ones. Without Redis in production all
#three endpoints answer 503; npm run dev skips the limits, cap and cache, but /api/questions
#still answers 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=