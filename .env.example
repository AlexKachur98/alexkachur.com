# Variables read by /api/ask and /api/stats. Set the real values in Vercel and in a local .env;
# never commit them. Without a Redis pair, astro dev skips the rate limit, the cap and the cache.
ANTHROPIC_API_KEY=
# Optional, defaults to claude-haiku-4-5.
ANTHROPIC_MODEL=
# Model calls allowed per UTC month; 0 turns the endpoint off. Optional, defaults to 2000.
ASK_MONTHLY_CAP=
# Required. The secret that keys the rate limiter's hash of each address, so no address is stored as
# itself; without it /api/ask answers 503. Any long random string, for example the output of
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASK_RATE_LIMIT_SECRET=
# Either pair works; the Upstash names are read first.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
/api/questions